datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  storeId            String   @id @default(uuid())
  storeName          String
  content            String?
  takeOutInStore     Boolean? @default(true)
  shippingTimeInDays Int?
  latitude           String
  longitude          String
  address1           String
  address2           String
  address3           String
  city               String
  district           String
  state              String
  country            String
  postalCode         String
  telephoneNumber    String
  emailAddress       String
  type               String
}
